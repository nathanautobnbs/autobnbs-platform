# AutoBNBs Platform — Environment Variables
# Copy this file to .env.local and fill in your keys

# Claude AI API Key (Anthropic)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Unsplash API Access Key
# Get yours at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Buffer API (for social media scheduling)
# Get yours at: https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# Instagram Graph API (requires Facebook Developer Account)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORGANIZATION_ID=your_linkedin_organization_id_here

# Twitter/X API v2
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# TikTok API (TikTok for Business)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# App Settings
NEXT_PUBLIC_APP_NAME=AutoBNBs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (for securing automated cron endpoints)
CRON_SECRET=your_secure_random_string_here
